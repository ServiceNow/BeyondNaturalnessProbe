# Copy this file to .env and fill in the values you need.
# Only the credentials your chosen dimension(s) actually use are required —
# see README.md's "Setup" and "TTS Engines" sections for which dimensions
# need what.

# OpenAI credentials — pick ONE of the two options below.
# Option A: standard OpenAI
OPENAI_API_KEY=

# Option B: Azure OpenAI (used instead of OPENAI_API_KEY if both are set)
# AZURE_OPENAI_ENDPOINT=https://<your-endpoint>.openai.azure.com/
# AZURE_OPENAI_API_KEY=

# Required for every dimension except intonation
CARTESIA_API_KEY=

# intonation only
ELEVEN_LABS_API_KEY=
